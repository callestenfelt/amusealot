# Baserow (self-hosted)
BASEROW_URL=http://your-baserow-server
BASEROW_TOKEN=your-baserow-api-token
SUBSCRIBER_TABLE_ID=your-subscriber-table-id

# GitHub (personal access token)
GITHUB_TOKEN=ghp_your-github-token

# Groq (LLM scoring)
GROQ_API_KEY=gsk_your-groq-api-key

# Resend (email delivery)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM=AmuseAlot <newsletter@amusealot.com>

# Site
MUSEMANIAC_BASE_URL=https://amusealot.com
SOURCES_TABLE_ID=your-sources-table-id
EDITION_TABLE_ID=your-edition-table-id
FEEDBACK_TABLE_ID=your-feedback-table-id

# Optional: Technologies table for Tool Watch feature
# TECHNOLOGIES_TABLE_ID=your-technologies-table-id

# Optional: Cultural Heritage News feature (Phase 1: RSS feeds)
# NEWS_SOURCES_TABLE_ID=your-news-sources-table-id
# NEWS_ARTICLES_TABLE_ID=your-news-articles-table-id

# Optional: Email notifications for feedback
# NOTIFY_EMAIL=your-email@example.com
