<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <title>AmuseAlot — Museum Tech Newsletter</title>
  <!--[if mso]>
  <style type="text/css">
    table { border-collapse: collapse; }
    td { font-family: Arial, sans-serif; }
  </style>
  <![endif]-->
  <style type="text/css">
    :root { color-scheme: light only; }
    a.link:hover { color: #080229 !important; }
    .ehdr img { padding-bottom: 5px !important; }
    [data-ogsc] body, [data-ogsb] body { background-color: #fbfbfb !important; color: #080229 !important; }
    [data-ogsc] table, [data-ogsb] table { background-color: #fbfbfb !important; }
    [data-ogsc] .wn-box, [data-ogsb] .wn-box { background-color: #1C1736 !important; }
    [data-ogsc] .wn-box td, [data-ogsb] .wn-box td { color: #fbfbfb !important; }
    [data-ogsc] td, [data-ogsb] td { color: #080229 !important; }
    [data-ogsc] a, [data-ogsb] a { color: #080229 !important; }
    [data-ogsc] span, [data-ogsb] span { color: #080229 !important; }
    @media (prefers-color-scheme: dark) {
      .wn-box { background-color: #1C1736 !important; }
      .wn-box td { color: #fbfbfb !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background-color:#fbfbfb;font-family:Arial,'Helvetica Neue',Helvetica,sans-serif;color:#080229;">

{# ============================================================
   SHARED STYLES
   ============================================================ #}
{% set dot_border = "background-image:repeating-linear-gradient(to right,#080229 0,#080229 2px,transparent 2px,transparent 6px);background-size:100% 1px;background-position:bottom;background-repeat:no-repeat;" %}

{# ============================================================
   MACROS
   ============================================================ #}

{% macro dotline() %}
<tr>
  <td style="padding:0 40px;font-size:0;line-height:0;height:1px;">
    <div style="height:1px;background-image:repeating-linear-gradient(to right,#080229 0,#080229 2px,transparent 2px,transparent 6px);"></div>
  </td>
</tr>
{% endmacro %}

{% macro section_header(emoji, text) %}
<tr>
  <td style="padding:48px 40px 24px 40px;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
      <tr>
        <td style="font-size:20px;font-weight:bold;color:#080229;letter-spacing:-1px;padding-bottom:16px;border-bottom:3px solid #080229;">
          <span class="ehdr" style="font-size:22px;vertical-align:middle;letter-spacing:0;">{{ emoji }}</span>
          <span style="vertical-align:middle;">{{ text }}</span>
        </td>
      </tr>
    </table>
  </td>
</tr>
{% endmacro %}

{% macro event_t1(event) %}
<tr>
  <td style="padding:20px 40px;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
      <tr>
        <td>
          <a href="{{ event.url }}" class="link" style="font-size:16px;font-weight:bold;color:#080229;text-decoration:underline;text-underline-offset:3px;">{{ event.repo.split('/')[1] }}</a>
        </td>
      </tr>
      <tr>
        <td style="font-size:13px;color:#080229;padding-top:6px;">
          {{ event.org_name }}
          {% if event.repo_meta and event.repo_meta.language %}
            &nbsp;&middot;&nbsp;{{ event.repo_meta.language }}
          {% endif %}
          {% if event.repo_meta and event.repo_meta.stars %}
            &nbsp;&middot;&nbsp;&#9733; {{ event.repo_meta.stars }}
          {% endif %}
        </td>
      </tr>
      {% if event.score and event.score.summary %}
      <tr>
        <td style="font-size:14px;color:#080229;padding-top:10px;line-height:1.6;">
          {{ event.score.summary }}
        </td>
      </tr>
      {% endif %}
    </table>
  </td>
</tr>
{% endmacro %}

{% macro event_t2(event) %}
<tr>
  <td style="padding:0 40px;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
      <tr>
        <td style="padding:10px 0;">
          <a href="{{ event.url }}" class="link" style="font-size:16px;font-weight:bold;color:#080229;text-decoration:underline;text-underline-offset:3px;">{{ event.repo.split('/')[1] }}</a>
          {% if event.details and event.details.tag is defined %}
            <span style="font-size:13px;color:#080229;">&nbsp;&middot;&nbsp;{{ event.details.tag }}</span>
          {% endif %}
          <br>
          <span style="font-size:13px;color:#080229;line-height:2.2;">{{ event.org_name }}</span>
        </td>
      </tr>
    </table>
  </td>
</tr>
{% endmacro %}

{# ============================================================
   OUTER WRAPPER
   ============================================================ #}

<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" bgcolor="#fbfbfb" style="background-color:#fbfbfb;">
  <tr>
    <td align="center" style="padding:0;">

      {# Inner container — 600px max #}
      <table width="600" cellpadding="0" cellspacing="0" border="0" role="presentation" bgcolor="#fbfbfb" style="max-width:600px;width:100%;background-color:#fbfbfb;">

        {# ========== HEADER ========== #}
        <tr>
          <td style="padding:48px 40px 40px 40px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              <tr>
                <td style="font-size:78px;font-weight:bold;color:#080229;letter-spacing:-5.5px;padding-bottom:0;">
                  AmuseAlot
                </td>
              </tr>
              <tr>
                <td style="font-size:13px;color:#080229;letter-spacing:4.5px;text-transform:uppercase;">
                  Museum Tech Newsletter
                </td>
              </tr>
              <tr>
                <td style="font-size:13px;color:#080229;padding-top:6px;">
                  {{ generation_date }}
                </td>
              </tr>
            </table>
          </td>
        </tr>


        {# ========== INTRO ========== #}
        <tr>
          <td style="padding:0 40px 32px 40px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              <tr>
                <td style="font-size:16px;color:#080229;line-height:1.7;">
                  An AI-curated digest of what museums, archives, heritage organizations, and
                  individual researchers are building on GitHub &mdash; new projects, releases,
                  and notable developments delivered every Wednesday.
                </td>
              </tr>
              {% if whats_new %}
              <tr>
                <td style="padding-top:20px;">
                  <table class="wn-box" width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="background-color:#EDEBF5;border-radius:8px;">
                    <tr>
                      <td style="padding:20px;font-size:14px;font-weight:bold;color:#080229;">What's new</td>
                    </tr>
                    <tr>
                      <td style="padding:0 20px 20px 20px;font-size:13px;color:#080229;line-height:1.8;">
                        {% for item in whats_new %}
                        &bull;&nbsp; {{ item | safe }}{% if not loop.last %}<br>{% endif %}
                        {% endfor %}
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
              {% endif %}
            </table>
          </td>
        </tr>
        {{ dotline() }}

        {# ========== SPOTLIGHT ========== #}
        <tr>
          <td style="padding:36px 40px 32px 40px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              <tr>
                <td style="font-size:20px;font-weight:bold;color:#080229;letter-spacing:-1px;padding-bottom:16px;border-bottom:3px solid #080229;">
                  <span class="ehdr" style="font-size:22px;vertical-align:middle;letter-spacing:0;">🌟</span>
                  <span style="vertical-align:middle;">Spotlight</span>
                </td>
              </tr>
              <tr>
                <td style="padding-top:24px;">
                  <a href="https://github.com/{{ spotlight.event.repo }}" class="link" style="font-size:18px;font-weight:bold;color:#080229;text-decoration:underline;text-underline-offset:3px;">
                    {{ spotlight.event.repo.split('/')[1] if spotlight.event.repo else '' }}
                  </a>
                </td>
              </tr>
              <tr>
                <td style="padding-top:6px;font-size:13px;color:#080229;">
                  {{ spotlight.event.org_name }}
                </td>
              </tr>
              <tr>
                <td style="padding-top:16px;font-size:14px;color:#080229;line-height:1.7;">
                  {{ spotlight.writeup }}
                </td>
              </tr>
              <tr>
                <td style="padding-top:16px;">
                  <a href="https://github.com/{{ spotlight.event.repo }}" class="link" style="font-size:13px;color:#080229;text-decoration:underline;text-underline-offset:2px;">View on GitHub</a>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        {{ dotline() }}

        {# ========== STATS BAR ========== #}
        <tr>
          <td style="padding:32px 40px 28px 40px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              <tr>
                <td colspan="5" style="font-size:20px;font-weight:bold;color:#080229;letter-spacing:-1px;white-space:nowrap;padding-bottom:20px;text-align:center;">
                  <span class="ehdr" style="font-size:22px;vertical-align:middle;letter-spacing:0;">⚡</span>
                  <span style="vertical-align:middle;">Activity This Week</span>
                </td>
              </tr>
              <tr>
                {% for stat in [
                  ("Active Orgs", stats.active_orgs),
                  ("Pushes", stats.total_pushes),
                  ("Repos", stats.unique_repos),
                  ("New Projects", stats.new_projects),
                  ("Releases", stats.releases),
                ] %}
                <td align="center" width="20%" style="padding:4px 2px;">
                  <span style="display:block;font-size:24px;font-weight:bold;color:#080229;">{{ stat[1] }}</span>
                  <span style="display:block;font-size:10px;color:#080229;text-transform:uppercase;letter-spacing:0.5px;padding-top:4px;">{{ stat[0] }}</span>
                </td>
                {% endfor %}
              </tr>
            </table>
          </td>
        </tr>
        {{ dotline() }}

        {# ========== NEW REPOS ========== #}
        {% if has_new_repos %}
        {{ section_header("🥚", "New Repositories") }}
        {% for event in sections.new_repos %}
          {% if event.score.tier == 1 %}
            {{ event_t1(event) }}
          {% else %}
            {{ event_t2(event) }}
          {% endif %}
        {% endfor %}
        {% endif %}

        {# ========== RELEASES ========== #}
        {% if has_releases %}
        {{ section_header("🚀", "Releases") }}
        {% for event in sections.releases %}
          {% if event.score.tier == 1 %}
            {{ event_t1(event) }}
          {% else %}
            {{ event_t2(event) }}
          {% endif %}
        {% endfor %}
        {% endif %}

        {# ========== MOST ACTIVE REPOS ========== #}
        {{ section_header("🔥", "Most Active Repos") }}
        <tr>
          <td style="padding:0 40px 0 40px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              {% for repo in most_active %}
              <tr>
                <td style="padding:16px 0;{% if not loop.last %}{{ dot_border }}{% endif %}">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
                    <tr>
                      <td width="28" valign="top" style="font-size:14px;font-weight:bold;color:#080229;padding-right:8px;">
                        {{ loop.index }}.
                      </td>
                      <td>
                        <a href="https://github.com/{{ repo.repo }}" class="link" style="font-size:14px;font-weight:600;color:#080229;text-decoration:underline;text-underline-offset:2px;">{{ repo.repo.split('/')[1] }}</a>
                        <span style="font-size:13px;color:#080229;">&nbsp;&mdash;&nbsp;{{ repo.repo.split('/')[0] }}</span>
                        <br>
                        <span style="font-size:12px;color:#080229;padding-top:2px;">
                          {{ repo.total_commits }} commit{{ 's' if repo.total_commits != 1 else '' }},
                          {{ repo.files_changed }} file{{ 's' if repo.files_changed != 1 else '' }} changed
                        </span>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
              {% endfor %}
            </table>
          </td>
        </tr>

        {# ========== NOTABLE PUSHES ========== #}
        {% if has_pushes %}
        {{ section_header("🤖", "Notable Pushes") }}
        {% for event in sections.pushes %}
          {% if max_pushes and loop.index > max_pushes %}
          {% else %}
            {% if event.score.tier == 1 %}
              {{ event_t1(event) }}
            {% else %}
              {{ event_t2(event) }}
            {% endif %}
          {% endif %}
        {% endfor %}
        {% if max_pushes and sections.pushes|length > max_pushes %}
        <tr>
          <td style="padding:20px 40px 0 40px;">
            <a href="https://amusealot.com/archive/{{ generation_date_iso }}" class="link" style="font-size:14px;font-weight:bold;color:#080229;text-decoration:underline;text-underline-offset:3px;">See all {{ sections.pushes|length }} pushes in the full edition</a>
          </td>
        </tr>
        {% endif %}
        <tr><td style="height:100px;"></td></tr>
        {% endif %}

      </table>
      {# /Inner container #}

    </td>
  </tr>
</table>

{# ========== FEEDBACK — full width ========== #}
<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" bgcolor="#fbfbfb" style="background-color:#fbfbfb;">
  <tr>
    <td align="center" style="padding:0;">
      <table width="600" cellpadding="0" cellspacing="0" border="0" role="presentation" style="max-width:600px;width:100%;">
        <tr>
          <td style="padding:0 40px;">
            <div style="height:1px;background-image:repeating-linear-gradient(to right,#080229 0,#080229 2px,transparent 2px,transparent 6px);"></div>
          </td>
        </tr>
        <tr>
          <td align="center" style="padding:32px 40px 8px 40px;font-size:18px;font-weight:bold;color:#080229;">
            How was this edition?
          </td>
        </tr>
        <tr>
          <td align="center" style="padding:4px 40px 24px 40px;font-size:13px;color:#080229;opacity:0.7;">
            Your feedback helps us improve
          </td>
        </tr>
        {% set ratings = [
          (5, "Excellent", "★★★★★"),
          (4, "Very Good", "★★★★☆"),
          (3, "Good", "★★★☆☆"),
          (2, "Fair", "★★☆☆☆"),
          (1, "Poor", "★☆☆☆☆"),
        ] %}
        {% for value, label, stars in ratings %}
        <tr>
          <td align="center" style="padding:0 40px 8px 40px;">
            <a href="https://amusealot.com/feedback?edition={{ generation_date_iso }}&rating={{ value }}" style="text-decoration:none;display:block;">
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="border:2px solid #080229;">
                <tr>
                  <td style="padding:12px 16px;font-size:15px;color:#080229;font-family:Arial,'Helvetica Neue',Helvetica,sans-serif;">
                    <span style="margin-right:8px;">{{ stars }}</span>
                    <span style="font-weight:bold;">{{ label }}</span>
                  </td>
                </tr>
              </table>
            </a>
          </td>
        </tr>
        {% endfor %}
        <tr><td style="height:76px;"></td></tr>
      </table>
    </td>
  </tr>
</table>

{# ========== FOOTER — full width ========== #}
<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" bgcolor="#080229" style="background-color:#080229;">
  <tr>
    <td align="center" style="padding:60px 40px 24px 40px;">
      <span style="font-size:16px;color:#fbfbfb;">
        Powered by <a href="https://github.com/callestenfelt/musemaniac" style="color:#fbfbfb;text-decoration:underline;text-underline-offset:2px;">musemaniac</a>
        &nbsp;&middot;&nbsp;Generated {{ generation_date }}
      </span>
    </td>
  </tr>
  <tr>
    <td align="center" style="padding:12px 40px 12px 40px;">
      <span style="font-size:12px;color:#fbfbfb;opacity:0.6;">
        Content is curated and summarized with the help of AI.
        <a href="https://amusealot.com/about" style="color:#fbfbfb;text-decoration:underline;text-underline-offset:2px;">Learn how it works</a>
      </span>
    </td>
  </tr>
  <tr>
    <td align="center" style="padding:0 40px 12px 40px;">
      <span style="font-size:13px;color:#fbfbfb;opacity:0.7;">
        <a href="https://amusealot.com/archive/{{ generation_date_iso }}" style="color:#fbfbfb;text-decoration:underline;text-underline-offset:2px;">View in browser</a>
        &nbsp;&middot;&nbsp;
        <a href="https://amusealot.com/archive" style="color:#fbfbfb;text-decoration:underline;text-underline-offset:2px;">Past issues</a>
      </span>
    </td>
  </tr>
  <tr>
    <td align="center" style="padding:0 40px 60px 40px;">
      <span style="font-size:13px;color:#fbfbfb;opacity:0.7;">
        <a href="%%UNSUBSCRIBE_URL%%" style="color:#fbfbfb;text-decoration:underline;text-underline-offset:2px;">Unsubscribe</a>
        &nbsp;&middot;&nbsp;
        <a href="https://amusealot.com/privacy" style="color:#fbfbfb;text-decoration:underline;text-underline-offset:2px;">Privacy Policy</a>
      </span>
    </td>
  </tr>
</table>

</body>
</html>
