<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>AmuseAlot — Museum Tech Newsletter</title>
  <!--[if mso]>
  <style type="text/css">
    table { border-collapse: collapse; }
    td { font-family: Arial, sans-serif; }
  </style>
  <![endif]-->
  <style type="text/css">
    :root { color-scheme: light; }
    a.link:hover { color: #080229 !important; }
    .wn-box a { color: #080229 !important; text-decoration: underline; }
    /* Dark mode for Outlook.com / new Outlook / Outlook mobile — the only clients that
       inject data-ogsc/data-ogsb. Classic Word-engine Outlook for Windows desktop (and
       the Windows Mail app) ignore ALL of these rules and run their own colour inversion;
       white-on-white there is prevented instead by pairing background-color with color on
       every text cell (below), so Outlook's invert stays coherent.
       NB: because each text cell now carries its own light background-color inline, the td
       rule here must also force that background dark, or webmail dark mode would leave a
       light cell behind forced-white text. */
    [data-ogsc] body, [data-ogsb] body { background-color: #080229 !important; }
    [data-ogsc] table, [data-ogsb] table { background-color: #080229 !important; }
    [data-ogsc] td, [data-ogsb] td { background-color: #080229 !important; color: #F7F5F1 !important; }
    [data-ogsc] .wn-box, [data-ogsb] .wn-box { background-color: #241C3E !important; border-color: #3a3260 !important; }
    [data-ogsc] .wn-box td, [data-ogsb] .wn-box td { background-color: #241C3E !important; }
    [data-ogsc] .sec-hdr, [data-ogsb] .sec-hdr { border-color: #F7F5F1 !important; }
    /* Spans and anchors now carry their own inline background-color for the
       same-element pairing rule, so — like the td rule above — force it dark here
       or webmail dark mode shows light chips behind forced-light text. Elements
       inside the .wn-box panel get its lighter dark tone instead (same pattern
       as the .wn-box td rule above). */
    [data-ogsc] a, [data-ogsb] a { color: #C4BBF6 !important; background-color: #080229 !important; }
    [data-ogsc] span, [data-ogsb] span { color: #F7F5F1 !important; background-color: #080229 !important; }
    [data-ogsc] .wn-box a, [data-ogsb] .wn-box a { background-color: #241C3E !important; }
    [data-ogsc] .wn-box span, [data-ogsb] .wn-box span { background-color: #241C3E !important; }
    /* The 2px rating borders live on the five .rate-box TDs (not the table). */
    [data-ogsc] .rate-box td, [data-ogsb] .rate-box td { border-color: #F7F5F1 !important; }
    /* Structural 3px ink rules (masthead divider, footer top) re-pin light. */
    [data-ogsc] .rule-td, [data-ogsb] .rule-td { border-color: #F7F5F1 !important; }
    /* #ddd8ce hairlines invert to the dark panel hairline tone instead of glare. */
    [data-ogsc] .hairline, [data-ogsb] .hairline { border-color: #3a3260 !important; }
    [data-ogsc] .rate-box a, [data-ogsb] .rate-box a { color: #F7F5F1 !important; background-color: #080229 !important; }
  </style>
</head>
<body style="margin:0;padding:0;background-color:#F7F5F1;font-family:Arial,'Helvetica Neue',Helvetica,sans-serif;color:#080229;">

{# ============================================================
   SHARED STYLES
   ============================================================ #}
{# Section counter for the numbered header system (01 SPOTLIGHT, 02 ...).
   Sections are conditional, so numbers are assigned at render time by the
   section_header macro — never hardcode them. #}
{% set sec = namespace(n=0) %}

{# ============================================================
   COLOUR-PAIRING NOTE
   Every text-bearing <td> carries an explicit background-color matching its
   section (#F7F5F1 body + footer, #FAF9F6 card panels/news band). This is
   what keeps classic Outlook desktop dark mode from producing white-on-white:
   when background and text live on the same element, Outlook inverts them as a
   pair. Do NOT remove a cell's background-color without removing its sibling
   text color too, and keep them in the same section's palette.
   ============================================================ #}

{# ============================================================
   MACROS
   ============================================================ #}

{# Numbered small-caps section header — the typographic system that replaced
   the emoji headers (ratified 2026-08-27). All-Arial on purpose: this is the
   worst-client floor and must render identically everywhere. #}
{% macro section_header(text, bg="#F7F5F1") %}
{% set sec.n = sec.n + 1 %}
<tr>
  <td style="padding:44px 40px 24px 40px;background-color:{{ bg }};">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
      <tr>
        <td class="sec-hdr" style="font-size:13px;font-weight:bold;color:#080229;background-color:{{ bg }};letter-spacing:3.5px;text-transform:uppercase;padding-bottom:12px;border-bottom:3px solid #080229;">
          <span style="color:#5c5876;background-color:{{ bg }};letter-spacing:1px;">{{ '%02d'|format(sec.n) }}</span>&nbsp;&nbsp;<span style="color:#080229;background-color:{{ bg }};">{{ text }}</span>
        </td>
      </tr>
    </table>
  </td>
</tr>
{% endmacro %}

{% macro event_t1(event) %}
<tr>
  <td style="padding:20px 40px;background-color:#F7F5F1;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
      <tr>
        <td style="background-color:#F7F5F1;">
          <a href="{{ event.url }}" class="link" style="font-size:16px;font-weight:bold;color:#080229;background-color:#F7F5F1;text-decoration:underline;text-underline-offset:3px;">{{ event.repo.split('/')[-1] }}</a>
        </td>
      </tr>
      <tr>
        <td style="font-size:13px;color:#080229;background-color:#F7F5F1;padding-top:6px;">
          {{ event.org_name }}
          {% if event.repo_meta and event.repo_meta.language %}
            &nbsp;&middot;&nbsp;{{ event.repo_meta.language }}
          {% endif %}
          {% if event.repo_meta and event.repo_meta.stars %}
            &nbsp;&middot;&nbsp;&#9733; {{ event.repo_meta.stars }}
          {% endif %}
        </td>
      </tr>
      {% if event.score and event.score.summary %}
      <tr>
        <td style="font-size:14px;color:#080229;background-color:#F7F5F1;padding-top:10px;line-height:1.6;">
          {{ event.score.summary }}
        </td>
      </tr>
      {% endif %}
    </table>
  </td>
</tr>
{% endmacro %}

{% macro event_t2(event) %}
<tr>
  <td style="padding:0 40px;background-color:#F7F5F1;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
      <tr>
        <td style="padding:10px 0;background-color:#F7F5F1;">
          <a href="{{ event.url }}" class="link" style="font-size:16px;font-weight:bold;color:#080229;background-color:#F7F5F1;text-decoration:underline;text-underline-offset:3px;">{{ event.repo.split('/')[-1] }}</a>
          {% if event.details and event.details.tag is defined %}
            <span style="font-size:13px;color:#080229;background-color:#F7F5F1;">&nbsp;&middot;&nbsp;{{ event.details.tag }}</span>
          {% endif %}
          <br>
          <span style="font-size:13px;color:#080229;background-color:#F7F5F1;line-height:2.2;">{{ event.org_name }}</span>
        </td>
      </tr>
    </table>
  </td>
</tr>
{% endmacro %}

{# ============================================================
   OUTER WRAPPER
   ============================================================ #}

<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" bgcolor="#F7F5F1" style="background-color:#F7F5F1;">
  <tr>
    <td align="center" style="padding:0;background-color:#F7F5F1;">

      {# Inner container — 600px max #}
      <table width="600" cellpadding="0" cellspacing="0" border="0" role="presentation" bgcolor="#F7F5F1" style="max-width:600px;width:100%;background-color:#F7F5F1;">

        {# ========== HEADER ========== #}
        {# Wordmark is Arial bold, tight-tracked — identical to the site header. #}
        <tr>
          <td style="padding:44px 40px 28px 40px;background-color:#F7F5F1;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              {# Stacked rows: a tagline+date pair on one row overflows at phone
                 widths (no @media rules exist in email), so each gets its own row. #}
              <tr>
                <td style="font-size:34px;font-weight:bold;color:#080229;background-color:#F7F5F1;letter-spacing:-2px;padding-bottom:8px;">
                  AmuseAlot
                </td>
              </tr>
              <tr>
                <td style="font-size:11px;font-weight:bold;color:#080229;background-color:#F7F5F1;letter-spacing:3.5px;text-transform:uppercase;padding-bottom:4px;">
                  Museum Tech Newsletter
                </td>
              </tr>
              <tr>
                <td style="font-size:12px;color:#5c5876;background-color:#F7F5F1;padding-bottom:16px;">
                  {{ generation_date }}
                </td>
              </tr>
              <tr>
                <td class="rule-td" style="border-top:3px solid #080229;background-color:#F7F5F1;font-size:0;line-height:0;height:1px;">&nbsp;</td>
              </tr>
            </table>
          </td>
        </tr>


        {# ========== INTRO ========== #}
        <tr>
          <td style="padding:0 40px 32px 40px;background-color:#F7F5F1;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              <tr>
                <td style="font-size:16px;color:#080229;background-color:#F7F5F1;line-height:1.7;">
                  An AI-curated digest of what museums, archives, heritage organizations, and
                  individual researchers are building on GitHub &mdash; plus curated news from the cultural heritage sector &mdash; delivered every Wednesday.
                </td>
              </tr>
              {% if whats_new %}
              <tr>
                <td style="padding-top:20px;background-color:#F7F5F1;">
                  <table class="wn-box" width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="background-color:#FAF9F6;border:1px solid #ddd8ce;">
                    <tr>
                      <td style="padding:20px;font-size:14px;font-weight:bold;color:#080229;background-color:#FAF9F6;">What's new</td>
                    </tr>
                    <tr>
                      <td style="padding:0 20px 20px 20px;font-size:13px;color:#080229;background-color:#FAF9F6;line-height:1.8;">
                        {% for item in whats_new %}
                        &bull;&nbsp; {{ item | safe }}{% if not loop.last %}<br>{% endif %}
                        {% endfor %}
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
              {% endif %}
            </table>
          </td>
        </tr>


        {# ========== THIS WEEK'S NUMBERS ========== #}
        {# Weekly-first: only numbers that change each week lead; the static
           corpus size (sources/countries) is demoted to the footnote. #}
        <tr>
          <td style="padding:8px 40px 24px 40px;background-color:#F7F5F1;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              <tr>
                <td width="33%" valign="top" style="padding:12px 4px 16px 0;background-color:#F7F5F1;">
                  <span style="display:block;font-size:40px;font-weight:bold;color:#080229;background-color:#F7F5F1;letter-spacing:-1.5px;">{{ stats.new_projects }}</span>
                  <span style="display:block;font-size:10px;font-weight:bold;color:#5c5876;background-color:#F7F5F1;text-transform:uppercase;letter-spacing:2px;padding-top:4px;">New Repos</span>
                </td>
                <td width="34%" valign="top" style="padding:12px 4px 16px 4px;background-color:#F7F5F1;">
                  <span style="display:block;font-size:40px;font-weight:bold;color:#080229;background-color:#F7F5F1;letter-spacing:-1.5px;">{{ stats.releases }}</span>
                  <span style="display:block;font-size:10px;font-weight:bold;color:#5c5876;background-color:#F7F5F1;text-transform:uppercase;letter-spacing:2px;padding-top:4px;">Releases</span>
                </td>
                <td width="33%" valign="top" style="padding:12px 0 16px 4px;background-color:#F7F5F1;">
                  <span style="display:block;font-size:40px;font-weight:bold;color:#080229;background-color:#F7F5F1;letter-spacing:-1.5px;">{{ stats.active_orgs }}</span>
                  <span style="display:block;font-size:10px;font-weight:bold;color:#5c5876;background-color:#F7F5F1;text-transform:uppercase;letter-spacing:2px;padding-top:4px;">Active Orgs</span>
                </td>
              </tr>
              {% if source_stats.total_sources > 0 %}
              <tr>
                <td colspan="3" class="hairline" style="border-top:1px solid #ddd8ce;font-size:12px;color:#5c5876;background-color:#F7F5F1;padding-top:12px;">
                  This week, from the {{ source_stats.total_sources }} sources we track{% if source_stats.total_countries > 0 %} in {{ source_stats.total_countries }}{% if source_stats.total_countries > 30 %}+{% endif %} countries{% endif %}.
                </td>
              </tr>
              {% endif %}
            </table>
          </td>
        </tr>


        {# ========== SPOTLIGHT ========== #}
        {% if spotlight.event.repo and spotlight.writeup %}
        {{ section_header("Spotlight") }}
        <tr>
          <td style="padding:0 40px 32px 40px;background-color:#F7F5F1;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              <tr>
                <td style="padding-top:4px;background-color:#F7F5F1;">
                  <a href="https://github.com/{{ spotlight.event.repo }}" class="link" style="font-size:18px;font-weight:bold;color:#080229;background-color:#F7F5F1;text-decoration:underline;text-underline-offset:3px;">
                    {{ spotlight.event.repo.split('/')[-1] if spotlight.event.repo else '' }}
                  </a>
                </td>
              </tr>
              <tr>
                <td style="padding-top:6px;font-size:13px;color:#080229;background-color:#F7F5F1;">
                  {{ spotlight.event.org_name }}
                </td>
              </tr>
              <tr>
                <td style="padding-top:16px;font-size:14px;color:#080229;background-color:#F7F5F1;line-height:1.7;">
                  {{ spotlight.writeup }}
                </td>
              </tr>
              <tr>
                <td style="padding-top:16px;background-color:#F7F5F1;">
                  <a href="https://github.com/{{ spotlight.event.repo }}" class="link" style="font-size:13px;color:#080229;background-color:#F7F5F1;text-decoration:underline;text-underline-offset:2px;">View on GitHub</a>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        {% endif %}


        {# ========== NEW REPOS ========== #}
        {% if has_new_repos %}
        {{ section_header("New Repositories") }}
        {% for event in sections.new_repos %}
          {% if not section_cap or loop.index <= section_cap %}
            {% if event.score.tier == 1 %}
              {{ event_t1(event) }}
            {% else %}
              {{ event_t2(event) }}
            {% endif %}
          {% endif %}
        {% endfor %}
        {% if section_cap and total_new_repos > section_cap %}
        <tr>
          <td style="padding:20px 40px 0 40px;background-color:#F7F5F1;">
            <a href="https://amusealot.com/archive/{{ generation_date_iso }}" class="link" style="font-size:14px;font-weight:bold;color:#080229;background-color:#F7F5F1;text-decoration:underline;text-underline-offset:3px;">See all {{ total_new_repos }} new repositories in the full edition</a>
          </td>
        </tr>
        {% endif %}
        {% endif %}

        {# ========== RELEASES ========== #}
        {% if has_releases %}
        {{ section_header("Releases") }}
        {% for event in sections.releases %}
          {% if not section_cap or loop.index <= section_cap %}
            {% if event.score.tier == 1 %}
              {{ event_t1(event) }}
            {% else %}
              {{ event_t2(event) }}
            {% endif %}
          {% endif %}
        {% endfor %}
        {% if section_cap and total_releases > section_cap %}
        <tr>
          <td style="padding:20px 40px 0 40px;background-color:#F7F5F1;">
            <a href="https://amusealot.com/archive/{{ generation_date_iso }}" class="link" style="font-size:14px;font-weight:bold;color:#080229;background-color:#F7F5F1;text-decoration:underline;text-underline-offset:3px;">See all {{ total_releases }} releases in the full edition</a>
          </td>
        </tr>
        {% endif %}
        {% endif %}

        {# ========== MOST ACTIVE REPOS ========== #}
        {# Guarded: compute_most_active counts only push events, so a week
           without pushes yields an empty list — an unguarded header would
           render over nothing AND consume a section number. #}
        {% if most_active %}
        {{ section_header("Most Active Repos") }}
        <tr>
          <td style="padding:0 40px 0 40px;background-color:#F7F5F1;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              {% for repo in most_active %}
              <tr>
                <td style="padding:16px 0;background-color:#F7F5F1;">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
                    <tr>
                      <td width="28" valign="top" style="font-size:14px;font-weight:bold;color:#080229;background-color:#F7F5F1;padding-right:8px;">
                        {{ loop.index }}.
                      </td>
                      <td style="background-color:#F7F5F1;">
                        <a href="https://github.com/{{ repo.repo }}" class="link" style="font-size:14px;font-weight:600;color:#080229;background-color:#F7F5F1;text-decoration:underline;text-underline-offset:2px;">{{ repo.repo.split('/')[-1] }}</a>
                        {% if '/' in repo.repo %}
                        <span style="font-size:13px;color:#080229;background-color:#F7F5F1;">&nbsp;&mdash;&nbsp;{{ repo.repo.split('/')[0] }}</span>
                        {% endif %}
                        <br>
                        <span style="font-size:12px;color:#080229;background-color:#F7F5F1;padding-top:2px;">
                          {{ repo.total_commits }} commit{{ 's' if repo.total_commits != 1 else '' }},
                          {{ repo.files_changed }} file{{ 's' if repo.files_changed != 1 else '' }} changed
                        </span>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
              {% endfor %}
            </table>
          </td>
        </tr>
        {% endif %}

        {# ========== INDIVIDUAL CREATORS ========== #}
        {% if has_individual_events %}
        {{ section_header("Individual Creators") }}
        {% for event in individual_events %}
          {% if event.score.tier == 1 %}
            {{ event_t1(event) }}
          {% else %}
            {{ event_t2(event) }}
          {% endif %}
        {% endfor %}
        {% if section_cap and total_individual_events > individual_events|length %}
        <tr>
          <td style="padding:20px 40px 0 40px;background-color:#F7F5F1;">
            <a href="https://amusealot.com/archive/{{ generation_date_iso }}" class="link" style="font-size:14px;font-weight:bold;color:#080229;background-color:#F7F5F1;text-decoration:underline;text-underline-offset:3px;">See all {{ total_individual_events }} individual creators in the full edition</a>
          </td>
        </tr>
        {% endif %}
        {% endif %}

        {# ========== NOTABLE PUSHES ========== #}
        {% if has_pushes %}
        {{ section_header("Notable Pushes") }}
        {% for event in sections.pushes %}
          {% if not section_cap or loop.index <= section_cap %}
            {% if event.score.tier == 1 %}
              {{ event_t1(event) }}
            {% else %}
              {{ event_t2(event) }}
            {% endif %}
          {% endif %}
        {% endfor %}
        {% if section_cap and total_pushes > section_cap %}
        <tr>
          <td style="padding:20px 40px 0 40px;background-color:#F7F5F1;">
            <a href="https://amusealot.com/archive/{{ generation_date_iso }}" class="link" style="font-size:14px;font-weight:bold;color:#080229;background-color:#F7F5F1;text-decoration:underline;text-underline-offset:3px;">See all {{ total_pushes }} pushes in the full edition</a>
          </td>
        </tr>
        {% endif %}
        {% endif %}

        {# ========== TOOL WATCH ========== #}
        {% if has_tool_watch %}
        {{ section_header("Tool Watch") }}
        <tr>
          <td style="padding:0 40px 0 40px;background-color:#F7F5F1;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              {% for parent, events in tool_watch.items() %}
              <tr>
                <td style="padding:20px 0 12px 0;background-color:#F7F5F1;">
                  <span style="font-size:15px;font-weight:bold;color:#080229;background-color:#F7F5F1;">{{ parent }}</span>
                </td>
              </tr>
              {% for event in events %}
              <tr>
                <td style="padding:0 0 16px 0;background-color:#F7F5F1;">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
                    <tr>
                      <td style="background-color:#F7F5F1;">
                        <a href="{{ event.url }}" class="link" style="font-size:14px;font-weight:600;color:#080229;background-color:#F7F5F1;text-decoration:underline;text-underline-offset:2px;">{{ event.technology_name }}</a>
                        {% if event.details and event.details.tag is defined %}
                          <span style="font-size:13px;color:#080229;background-color:#F7F5F1;">&nbsp;&middot;&nbsp;{{ event.details.tag }}</span>
                        {% endif %}
                        <br>
                        {% if event.score and event.score.summary %}
                        <span style="font-size:13px;color:#080229;background-color:#F7F5F1;line-height:1.6;">{{ event.score.summary }}</span>
                        <br>
                        {% endif %}
                        <a href="{{ event.url }}" class="link" style="font-size:12px;color:#080229;background-color:#F7F5F1;text-decoration:underline;text-underline-offset:2px;">View on GitHub</a>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
              {% endfor %}
              {% endfor %}
            </table>
          </td>
        </tr>
        {% if section_cap and total_tool_events > shown_tool_events %}
        <tr>
          <td style="padding:20px 40px 0 40px;background-color:#F7F5F1;">
            <a href="https://amusealot.com/archive/{{ generation_date_iso }}" class="link" style="font-size:14px;font-weight:bold;color:#080229;background-color:#F7F5F1;text-decoration:underline;text-underline-offset:3px;">See all {{ total_tool_events }} tool watch updates in the full edition</a>
          </td>
        </tr>
        {% endif %}
        {% endif %}

        <tr><td style="height:48px;background-color:#F7F5F1;"></td></tr>

      </table>
      {# /Inner container #}

    </td>
  </tr>
</table>

{# ========== NEWS + FEEDBACK — full bleed ========== #}
<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" bgcolor="#FAF9F6" class="hairline" style="background-color:#FAF9F6;border-top:1px solid #ddd8ce;border-bottom:1px solid #ddd8ce;">
  <tr>
    <td align="center" style="padding:0;background-color:#FAF9F6;">
      <table width="600" cellpadding="0" cellspacing="0" border="0" role="presentation" style="max-width:600px;width:100%;">

        {# ---- Cultural Heritage News ---- #}
        {% if has_news %}
        {{ section_header("Cultural Heritage News", "#FAF9F6") }}
        <tr>
          <td style="padding:0 40px 24px 40px;font-size:13px;color:#080229;background-color:#FAF9F6;line-height:1.7;opacity:0.8;">
            Not from GitHub, but still relevant. These articles are picked from cultural heritage and museum sources across Europe, then rated for relevance and translated to English when needed. AI can make mistakes &mdash; always check the original source if something is important.
          </td>
        </tr>
        {% for article in news_articles.newsletter %}
        <tr>
          <td style="padding:20px 40px;background-color:#FAF9F6;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              <tr>
                <td style="background-color:#FAF9F6;">
                  <a href="{{ article.url }}" class="link" style="font-size:16px;font-weight:bold;color:#080229;background-color:#FAF9F6;text-decoration:underline;text-underline-offset:3px;">
                    {{ article.score.ai_title if (article.language != 'en' and article.score.ai_title) else article.title }}
                  </a>
                </td>
              </tr>
              <tr>
                <td style="font-size:13px;color:#080229;background-color:#FAF9F6;opacity:0.8;padding-top:6px;">
                  {{ article.source_name }}
                  {% if article.published_date %} &middot; {{ article.published_date }}{% endif %}
                  {% if article.language and article.language != 'en' %} &middot; <span style="text-transform:uppercase;">{{ article.language }}</span>{% endif %}
                </td>
              </tr>
              {% if article.score.ai_summary %}
              <tr>
                <td style="font-size:14px;padding-top:10px;line-height:1.6;color:#080229;background-color:#FAF9F6;">
                  {{ article.score.ai_summary }}
                </td>
              </tr>
              {% elif article.summary %}
              <tr>
                <td style="font-size:14px;padding-top:10px;line-height:1.6;color:#080229;background-color:#FAF9F6;">
                  {{ article.summary[:200] }}{% if article.summary|length > 200 %}...{% endif %}
                </td>
              </tr>
              {% endif %}
            </table>
          </td>
        </tr>
        {% endfor %}
        {% if section_cap and news_articles.total > section_cap %}
        <tr>
          <td style="padding:20px 40px 0 40px;background-color:#FAF9F6;">
            <a href="https://amusealot.com/archive/{{ generation_date_iso }}" class="link" style="font-size:14px;font-weight:bold;color:#080229;background-color:#FAF9F6;text-decoration:underline;text-underline-offset:3px;">See all {{ news_articles.total }} articles in the full edition</a>
          </td>
        </tr>
        {% endif %}

        {% endif %}

        {# ---- Feedback ---- #}
        <tr>
          <td style="padding:{{ 32 if has_news else 48 }}px 40px 12px 40px;font-size:13px;font-weight:bold;color:#080229;background-color:#FAF9F6;letter-spacing:3.5px;text-transform:uppercase;">
            How was this edition?
          </td>
        </tr>
        {% set ratings = [
          (5, "Excellent"),
          (4, "Very good"),
          (3, "Good"),
          (2, "Fair"),
          (1, "Poor"),
        ] %}
        {# Compact one-row rating: five bordered number cells. The <a> sits
           INSIDE each cell (not wrapped around a table): Word-engine Outlook
           ignores block-level anchors around tables, which left the old rating
           rows unclickable there. Padding stays on the td for the same reason —
           the Word engine ignores padding (and display:block) on anchors; the
           number AND label both live inside the anchor so the Word-engine
           hotspot is the full text run and screen readers announce
           "5 Excellent", not a bare digit.
           border-left:none on non-first cells keeps adjacent borders single. #}
        <tr>
          <td style="padding:0 40px 12px 40px;background-color:#FAF9F6;">
            <table class="rate-box" width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              <tr>
                {% for value, label in ratings %}
                <td align="center" width="20%" style="border:2px solid #080229;{% if not loop.first %}border-left:none;{% endif %}padding:12px 4px;background-color:#FAF9F6;color:#080229;">
                  <a href="https://amusealot.com/feedback?edition={{ generation_date_iso }}&rating={{ value }}" style="display:block;color:#080229;background-color:#FAF9F6;text-decoration:none;font-family:Arial,'Helvetica Neue',Helvetica,sans-serif;"><span style="display:block;font-size:16px;font-weight:bold;color:#080229;background-color:#FAF9F6;">{{ value }}</span><span style="display:block;font-size:10px;color:#5c5876;background-color:#FAF9F6;padding-top:2px;">{{ label }}</span></a>
                </td>
                {% endfor %}
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td style="padding:0 40px 24px 40px;font-size:12px;color:#5c5876;background-color:#FAF9F6;">
            Tap a number &mdash; 5 is excellent, 1 is poor. One tap, no forms.
          </td>
        </tr>
        <tr><td style="height:40px;background-color:#FAF9F6;"></td></tr>

      </table>
    </td>
  </tr>
</table>

{# ========== FOOTER — full width, light with a ruled top ==========
   Non-inverted like everything else (ratified 2026-08-27): ink text on the
   paper ground, framed by a 3px solid rule — no dark block. #}
<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" bgcolor="#F7F5F1" style="background-color:#F7F5F1;">
  <tr>
    <td align="center" style="padding:0;background-color:#F7F5F1;">
      <table width="600" cellpadding="0" cellspacing="0" border="0" role="presentation" style="max-width:600px;width:100%;">
        <tr>
          <td class="rule-td" style="padding:36px 40px 8px 40px;border-top:3px solid #080229;background-color:#F7F5F1;">
            <span style="font-size:14px;color:#080229;background-color:#F7F5F1;">
              <span style="font-weight:bold;background-color:#F7F5F1;color:#080229;">AmuseAlot</span>
              &nbsp;&middot;&nbsp;Generated {{ generation_date }}
              &nbsp;&middot;&nbsp;Powered by <a href="https://github.com/callestenfelt/amusealot" style="color:#080229;background-color:#F7F5F1;text-decoration:underline;text-underline-offset:2px;">amusealot</a>
            </span>
          </td>
        </tr>
        <tr>
          <td style="padding:4px 40px 8px 40px;background-color:#F7F5F1;">
            <span style="font-size:12px;color:#5c5876;background-color:#F7F5F1;">
              Content is curated and summarized with the help of AI.
              <a href="https://amusealot.com/about" style="color:#5c5876;background-color:#F7F5F1;text-decoration:underline;text-underline-offset:2px;">Learn how it works</a>
            </span>
          </td>
        </tr>
        <tr>
          <td style="padding:0 40px 48px 40px;background-color:#F7F5F1;">
            <span style="font-size:13px;color:#5c5876;background-color:#F7F5F1;">
              <a href="https://amusealot.com/archive/{{ generation_date_iso }}" style="color:#5c5876;background-color:#F7F5F1;text-decoration:underline;text-underline-offset:2px;">View in browser</a>
              &nbsp;&middot;&nbsp;
              <a href="https://amusealot.com/archive" style="color:#5c5876;background-color:#F7F5F1;text-decoration:underline;text-underline-offset:2px;">Past issues</a>
              &nbsp;&middot;&nbsp;
              <a href="%%UNSUBSCRIBE_URL%%" style="color:#5c5876;background-color:#F7F5F1;text-decoration:underline;text-underline-offset:2px;">Unsubscribe</a>
              &nbsp;&middot;&nbsp;
              <a href="https://amusealot.com/privacy" style="color:#5c5876;background-color:#F7F5F1;text-decoration:underline;text-underline-offset:2px;">Privacy Policy</a>
            </span>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

</body>
</html>
