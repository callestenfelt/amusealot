<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>AmuseAlot — Museum Tech Newsletter</title>
  <!--[if mso]>
  <style type="text/css">
    table { border-collapse: collapse; }
    td { font-family: Arial, sans-serif; }
  </style>
  <![endif]-->
  <style type="text/css">
    :root { color-scheme: light; }
    a.link:hover { color: #080229 !important; }
    .ehdr img { padding-bottom: 5px !important; }
    .wn-box a { color: #080229 !important; text-decoration: underline; }
    /* Outlook dark mode (Windows desktop) */
    [data-ogsc] body, [data-ogsb] body { background-color: #080229 !important; }
    [data-ogsc] table, [data-ogsb] table { background-color: #080229 !important; }
    [data-ogsc] .wn-box, [data-ogsb] .wn-box { background-color: #1C1736 !important; }
    [data-ogsc] td, [data-ogsb] td { color: #fbfbfb !important; }
    [data-ogsc] .sec-hdr, [data-ogsb] .sec-hdr { border-color: #fbfbfb !important; }
    [data-ogsc] a, [data-ogsb] a { color: #C4BBF6 !important; }
    [data-ogsc] span, [data-ogsb] span { color: #fbfbfb !important; }
  </style>
</head>
<body style="margin:0;padding:0;background-color:#fbfbfb;font-family:Arial,'Helvetica Neue',Helvetica,sans-serif;color:#080229;mso-color-alt:#fbfbfb;">

{# ============================================================
   SHARED STYLES
   ============================================================ #}
{% set dot_border = "" %}

{# ============================================================
   MACROS
   ============================================================ #}

{% macro dotline() %}
<tr>
  <td style="padding:0 40px;font-size:0;line-height:0;height:1px;">
    <div style="height:1px;background-image:repeating-linear-gradient(to right,#080229 0,#080229 2px,transparent 2px,transparent 6px);"></div>
  </td>
</tr>
{% endmacro %}

{% macro section_header(emoji, text) %}
<tr>
  <td style="padding:48px 40px 24px 40px;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
      <tr>
        <td class="sec-hdr" style="font-size:20px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;letter-spacing:-1px;padding-bottom:16px;border-bottom:3px solid #080229;">
          <!--[if !mso]><!-->
          <span class="ehdr" style="font-size:22px;vertical-align:middle;letter-spacing:0;">{{ emoji }}</span>
          <!--<![endif]-->
          <span style="vertical-align:middle;">{{ text }}</span>
        </td>
      </tr>
    </table>
  </td>
</tr>
{% endmacro %}

{% macro event_t1(event) %}
<tr>
  <td style="padding:20px 40px;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
      <tr>
        <td>
          <a href="{{ event.url }}" class="link" style="font-size:16px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;text-decoration:underline;text-underline-offset:3px;">{{ event.repo.split('/')[1] }}</a>
        </td>
      </tr>
      <tr>
        <td style="font-size:13px;color:#080229;mso-color-alt:#fbfbfb;padding-top:6px;">
          {{ event.org_name }}
          {% if event.repo_meta and event.repo_meta.language %}
            &nbsp;&middot;&nbsp;{{ event.repo_meta.language }}
          {% endif %}
          {% if event.repo_meta and event.repo_meta.stars %}
            &nbsp;&middot;&nbsp;&#9733; {{ event.repo_meta.stars }}
          {% endif %}
        </td>
      </tr>
      {% if event.score and event.score.summary %}
      <tr>
        <td style="font-size:14px;color:#080229;mso-color-alt:#fbfbfb;padding-top:10px;line-height:1.6;">
          {{ event.score.summary }}
        </td>
      </tr>
      {% endif %}
    </table>
  </td>
</tr>
{% endmacro %}

{% macro event_t2(event) %}
<tr>
  <td style="padding:0 40px;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
      <tr>
        <td style="padding:10px 0;">
          <a href="{{ event.url }}" class="link" style="font-size:16px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;text-decoration:underline;text-underline-offset:3px;">{{ event.repo.split('/')[1] }}</a>
          {% if event.details and event.details.tag is defined %}
            <span style="font-size:13px;color:#080229;mso-color-alt:#fbfbfb;">&nbsp;&middot;&nbsp;{{ event.details.tag }}</span>
          {% endif %}
          <br>
          <span style="font-size:13px;color:#080229;mso-color-alt:#fbfbfb;line-height:2.2;">{{ event.org_name }}</span>
        </td>
      </tr>
    </table>
  </td>
</tr>
{% endmacro %}

{# ============================================================
   OUTER WRAPPER
   ============================================================ #}

<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" bgcolor="#fbfbfb" style="background-color:#fbfbfb;">
  <tr>
    <td align="center" style="padding:0;">

      {# Inner container — 600px max #}
      <table width="600" cellpadding="0" cellspacing="0" border="0" role="presentation" bgcolor="#fbfbfb" style="max-width:600px;width:100%;background-color:#fbfbfb;">

        {# ========== HEADER ========== #}
        <tr>
          <td style="padding:48px 40px 40px 40px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              <tr>
                <td style="font-size:78px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;letter-spacing:-5.5px;padding-bottom:0;">
                  AmuseAlot
                </td>
              </tr>
              <tr>
                <td style="font-size:13px;color:#080229;mso-color-alt:#fbfbfb;letter-spacing:4.5px;text-transform:uppercase;">
                  Museum Tech Newsletter
                </td>
              </tr>
              <tr>
                <td style="font-size:13px;color:#080229;mso-color-alt:#fbfbfb;padding-top:6px;">
                  {{ generation_date }}
                </td>
              </tr>
            </table>
          </td>
        </tr>


        {# ========== INTRO ========== #}
        <tr>
          <td style="padding:0 40px 32px 40px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              <tr>
                <td style="font-size:16px;color:#080229;mso-color-alt:#fbfbfb;line-height:1.7;">
                  An AI-curated digest of what museums, archives, heritage organizations, and
                  individual researchers are building on GitHub &mdash; plus curated news from the cultural heritage sector &mdash; delivered every Wednesday.
                  {% if source_stats.total_sources > 0 %}
                  <br><br>
                  Tracking {{ source_stats.total_sources }} sources{% if source_stats.total_countries > 0 %} in {{ source_stats.total_countries }}{% if source_stats.total_countries > 30 %}+{% endif %} countries{% endif %}.
                  {% endif %}
                </td>
              </tr>
              {% if whats_new %}
              <tr>
                <td style="padding-top:20px;">
                  <table class="wn-box" width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="background-color:#EDEBF5;border-radius:8px;">
                    <tr>
                      <td style="padding:20px;font-size:14px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;">What's new</td>
                    </tr>
                    <tr>
                      <td style="padding:0 20px 20px 20px;font-size:13px;color:#080229;mso-color-alt:#fbfbfb;line-height:1.8;">
                        {% for item in whats_new %}
                        &bull;&nbsp; {{ item | safe }}{% if not loop.last %}<br>{% endif %}
                        {% endfor %}
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
              {% endif %}
            </table>
          </td>
        </tr>


        {# ========== STATS BAR ========== #}
        <tr>
          <td style="padding:32px 40px 32px 40px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              <tr>
                <td colspan="3" class="sec-hdr" style="font-size:20px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;letter-spacing:-1px;padding-bottom:16px;border-bottom:3px solid #080229;text-align:center;">
                  This Week in Numbers
                </td>
              </tr>
              <tr>
                <td align="center" width="33%" valign="top" style="padding:24px 4px 16px 4px;">
                  <span style="display:block;font-size:32px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;">{{ source_stats.total_sources }}</span>
                  <span style="display:block;font-size:12px;color:#080229;mso-color-alt:#fbfbfb;text-transform:uppercase;letter-spacing:0.5px;padding-top:6px;">Sources</span>
                </td>
                <td align="center" width="34%" valign="top" style="padding:24px 4px 16px 4px;">
                  <span style="display:block;font-size:32px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;">{{ source_stats.total_countries }}</span>
                  <span style="display:block;font-size:12px;color:#080229;mso-color-alt:#fbfbfb;text-transform:uppercase;letter-spacing:0.5px;padding-top:6px;">Countries</span>
                </td>
                <td align="center" width="33%" valign="top" style="padding:24px 4px 16px 4px;">
                  <span style="display:block;font-size:32px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;">{{ stats.active_orgs }}</span>
                  <span style="display:block;font-size:12px;color:#080229;mso-color-alt:#fbfbfb;text-transform:uppercase;letter-spacing:0.5px;padding-top:6px;">Active Orgs</span>
                </td>
              </tr>
              <tr>
                <td align="center" width="33%" valign="top" style="padding:4px 4px;">
                  <span style="display:block;font-size:32px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;">{{ stats.new_projects }}</span>
                  <span style="display:block;font-size:12px;color:#080229;mso-color-alt:#fbfbfb;text-transform:uppercase;letter-spacing:0.5px;padding-top:6px;">New Repos</span>
                </td>
                <td align="center" width="34%" valign="top" style="padding:4px 4px;">
                  <span style="display:block;font-size:32px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;">{{ stats.releases }}</span>
                  <span style="display:block;font-size:12px;color:#080229;mso-color-alt:#fbfbfb;text-transform:uppercase;letter-spacing:0.5px;padding-top:6px;">Releases</span>
                </td>
                <td align="center" width="33%" valign="top" style="padding:4px 4px;">
                  <span style="display:block;font-size:32px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;">{{ news_articles.total if has_news else 0 }}</span>
                  <span style="display:block;font-size:12px;color:#080229;mso-color-alt:#fbfbfb;text-transform:uppercase;letter-spacing:0.5px;padding-top:6px;">News</span>
                </td>
              </tr>
            </table>
          </td>
        </tr>


        {# ========== SPOTLIGHT ========== #}
        <tr>
          <td style="padding:36px 40px 32px 40px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              <tr>
                <td class="sec-hdr" style="font-size:20px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;letter-spacing:-1px;padding-bottom:16px;border-bottom:3px solid #080229;">
                  <!--[if !mso]><!-->
                  <span class="ehdr" style="font-size:22px;vertical-align:middle;letter-spacing:0;">👀</span>
                  <!--<![endif]-->
                  <span style="vertical-align:middle;">Spotlight</span>
                </td>
              </tr>
              <tr>
                <td style="padding-top:24px;">
                  <a href="https://github.com/{{ spotlight.event.repo }}" class="link" style="font-size:18px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;text-decoration:underline;text-underline-offset:3px;">
                    {{ spotlight.event.repo.split('/')[1] if spotlight.event.repo else '' }}
                  </a>
                </td>
              </tr>
              <tr>
                <td style="padding-top:6px;font-size:13px;color:#080229;mso-color-alt:#fbfbfb;">
                  {{ spotlight.event.org_name }}
                </td>
              </tr>
              <tr>
                <td style="padding-top:16px;font-size:14px;color:#080229;mso-color-alt:#fbfbfb;line-height:1.7;">
                  {{ spotlight.writeup }}
                </td>
              </tr>
              <tr>
                <td style="padding-top:16px;">
                  <a href="https://github.com/{{ spotlight.event.repo }}" class="link" style="font-size:13px;color:#080229;mso-color-alt:#fbfbfb;text-decoration:underline;text-underline-offset:2px;">View on GitHub</a>
                </td>
              </tr>
            </table>
          </td>
        </tr>


        {# ========== NEW REPOS ========== #}
        {% if has_new_repos %}
        {{ section_header("🥚", "New Repositories") }}
        {% for event in sections.new_repos %}
          {% if loop.index <= 4 %}
            {% if event.score.tier == 1 %}
              {{ event_t1(event) }}
            {% else %}
              {{ event_t2(event) }}
            {% endif %}
          {% endif %}
        {% endfor %}
        {% if total_new_repos > 4 %}
        <tr>
          <td style="padding:20px 40px 0 40px;">
            <a href="https://amusealot.com/archive/{{ generation_date_iso }}" class="link" style="font-size:14px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;text-decoration:underline;text-underline-offset:3px;">See all {{ total_new_repos }} new repositories in the full edition</a>
          </td>
        </tr>
        {% endif %}
        {% endif %}

        {# ========== RELEASES ========== #}
        {% if has_releases %}
        {{ section_header("🚀", "Releases") }}
        {% for event in sections.releases %}
          {% if loop.index <= 4 %}
            {% if event.score.tier == 1 %}
              {{ event_t1(event) }}
            {% else %}
              {{ event_t2(event) }}
            {% endif %}
          {% endif %}
        {% endfor %}
        {% if total_releases > 4 %}
        <tr>
          <td style="padding:20px 40px 0 40px;">
            <a href="https://amusealot.com/archive/{{ generation_date_iso }}" class="link" style="font-size:14px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;text-decoration:underline;text-underline-offset:3px;">See all {{ total_releases }} releases in the full edition</a>
          </td>
        </tr>
        {% endif %}
        {% endif %}

        {# ========== MOST ACTIVE REPOS ========== #}
        {{ section_header("🔥", "Most Active Repos") }}
        <tr>
          <td style="padding:0 40px 0 40px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              {% for repo in most_active %}
              <tr>
                <td style="padding:16px 0;{% if not loop.last %}{{ dot_border }}{% endif %}">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
                    <tr>
                      <td width="28" valign="top" style="font-size:14px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;padding-right:8px;">
                        {{ loop.index }}.
                      </td>
                      <td>
                        <a href="https://github.com/{{ repo.repo }}" class="link" style="font-size:14px;font-weight:600;color:#080229;mso-color-alt:#fbfbfb;text-decoration:underline;text-underline-offset:2px;">{{ repo.repo.split('/')[1] }}</a>
                        <span style="font-size:13px;color:#080229;mso-color-alt:#fbfbfb;">&nbsp;&mdash;&nbsp;{{ repo.repo.split('/')[0] }}</span>
                        <br>
                        <span style="font-size:12px;color:#080229;mso-color-alt:#fbfbfb;padding-top:2px;">
                          {{ repo.total_commits }} commit{{ 's' if repo.total_commits != 1 else '' }},
                          {{ repo.files_changed }} file{{ 's' if repo.files_changed != 1 else '' }} changed
                        </span>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
              {% endfor %}
            </table>
          </td>
        </tr>

        {# ========== INDIVIDUAL CREATORS ========== #}
        {% if has_individual_events %}
        {{ section_header("👤", "Individual Creators") }}
        {% for event in individual_events %}
          {% if event.score.tier == 1 %}
            {{ event_t1(event) }}
          {% else %}
            {{ event_t2(event) }}
          {% endif %}
        {% endfor %}
        {% endif %}

        {# ========== NOTABLE PUSHES ========== #}
        {% if has_pushes %}
        {{ section_header("🤖", "Notable Pushes") }}
        {% for event in sections.pushes %}
          {% if loop.index <= 4 %}
            {% if event.score.tier == 1 %}
              {{ event_t1(event) }}
            {% else %}
              {{ event_t2(event) }}
            {% endif %}
          {% endif %}
        {% endfor %}
        {% if total_pushes > 4 %}
        <tr>
          <td style="padding:20px 40px 0 40px;">
            <a href="https://amusealot.com/archive/{{ generation_date_iso }}" class="link" style="font-size:14px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;text-decoration:underline;text-underline-offset:3px;">See all {{ total_pushes }} pushes in the full edition</a>
          </td>
        </tr>
        {% endif %}
        {% endif %}

        {# ========== TOOL WATCH ========== #}
        {% if has_tool_watch %}
        {{ section_header("🔧", "Tool Watch") }}
        <tr>
          <td style="padding:0 40px 0 40px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              {% for parent, events in tool_watch.items() %}
              <tr>
                <td style="padding:20px 0 12px 0;{% if not loop.first %}{{ dot_border }}{% endif %}">
                  <span style="font-size:15px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;">{{ parent }}</span>
                </td>
              </tr>
              {% for event in events %}
              <tr>
                <td style="padding:0 0 16px 0;">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
                    <tr>
                      <td>
                        <a href="{{ event.url }}" class="link" style="font-size:14px;font-weight:600;color:#080229;mso-color-alt:#fbfbfb;text-decoration:underline;text-underline-offset:2px;">{{ event.technology_name }}</a>
                        {% if event.details and event.details.tag is defined %}
                          <span style="font-size:13px;color:#080229;mso-color-alt:#fbfbfb;">&nbsp;&middot;&nbsp;{{ event.details.tag }}</span>
                        {% endif %}
                        <br>
                        {% if event.score and event.score.summary %}
                        <span style="font-size:13px;color:#080229;mso-color-alt:#fbfbfb;line-height:1.6;">{{ event.score.summary }}</span>
                        <br>
                        {% endif %}
                        <a href="{{ event.url }}" class="link" style="font-size:12px;color:#080229;mso-color-alt:#fbfbfb;text-decoration:underline;text-underline-offset:2px;">View on GitHub</a>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
              {% endfor %}
              {% endfor %}
            </table>
          </td>
        </tr>
        {% endif %}

        <tr><td style="height:48px;"></td></tr>

      </table>
      {# /Inner container #}

    </td>
  </tr>
</table>

{# ========== NEWS + FEEDBACK — full bleed ========== #}
<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" bgcolor="#EDEBF5" style="background-color:#EDEBF5;">
  <tr>
    <td align="center" style="padding:0;">
      <table width="600" cellpadding="0" cellspacing="0" border="0" role="presentation" style="max-width:600px;width:100%;">

        {# ---- Cultural Heritage News ---- #}
        {% if has_news %}
        {{ section_header("📢", "Cultural Heritage News") }}
        <tr>
          <td style="padding:0 40px 24px 40px;font-size:13px;color:#080229;mso-color-alt:#fbfbfb;line-height:1.7;opacity:0.8;">
            Not from GitHub, but still relevant. These articles are picked from cultural heritage and museum sources across Europe, then rated for relevance and translated to English when needed. AI can make mistakes &mdash; always check the original source if something is important.
          </td>
        </tr>
        {% for article in news_articles.newsletter %}
        <tr>
          <td style="padding:20px 40px;{% if not loop.first %}{{ dot_border }}{% endif %}">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              <tr>
                <td>
                  <a href="{{ article.url }}" class="link" style="font-size:16px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;text-decoration:underline;text-underline-offset:3px;">
                    {{ article.title }}
                  </a>
                </td>
              </tr>
              <tr>
                <td style="font-size:13px;color:#080229;mso-color-alt:#fbfbfb;opacity:0.8;padding-top:6px;">
                  {{ article.source_name }}
                  {% if article.published_date %} &middot; {{ article.published_date }}{% endif %}
                  {% if article.language and article.language != 'en' %} &middot; <span style="text-transform:uppercase;">{{ article.language }}</span>{% endif %}
                </td>
              </tr>
              {% if article.score.ai_summary %}
              <tr>
                <td style="font-size:14px;padding-top:10px;line-height:1.6;color:#080229;mso-color-alt:#fbfbfb;">
                  {{ article.score.ai_summary }}
                </td>
              </tr>
              {% elif article.summary %}
              <tr>
                <td style="font-size:14px;padding-top:10px;line-height:1.6;color:#080229;mso-color-alt:#fbfbfb;">
                  {{ article.summary[:200] }}{% if article.summary|length > 200 %}...{% endif %}
                </td>
              </tr>
              {% endif %}
            </table>
          </td>
        </tr>
        {% endfor %}
        {% if news_articles.total > 4 %}
        <tr>
          <td style="padding:20px 40px 0 40px;">
            <a href="https://amusealot.com/archive/{{ generation_date_iso }}" class="link" style="font-size:14px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;text-decoration:underline;text-underline-offset:3px;">See all {{ news_articles.total }} articles in the full edition</a>
          </td>
        </tr>
        {% endif %}

        {% endif %}

        {# ---- Feedback ---- #}
        <tr>
          <td align="center" style="padding:{{ 32 if has_news else 48 }}px 40px 8px 40px;font-size:18px;font-weight:bold;color:#080229;mso-color-alt:#fbfbfb;">
            How was this edition?
          </td>
        </tr>
        <tr>
          <td align="center" style="padding:4px 40px 24px 40px;font-size:13px;color:#080229;mso-color-alt:#fbfbfb;opacity:0.7;">
            Your feedback helps us improve
          </td>
        </tr>
        {% set ratings = [
          (5, "Excellent", "★★★★★"),
          (4, "Very Good", "★★★★☆"),
          (3, "Good", "★★★☆☆"),
          (2, "Fair", "★★☆☆☆"),
          (1, "Poor", "★☆☆☆☆"),
        ] %}
        {% for value, label, stars in ratings %}
        <tr>
          <td align="center" style="padding:0 40px 8px 40px;">
            <a href="https://amusealot.com/feedback?edition={{ generation_date_iso }}&rating={{ value }}" style="text-decoration:none;display:block;">
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="border:2px solid #080229;">
                <tr>
                  <td style="padding:12px 16px;font-size:15px;color:#080229;mso-color-alt:#fbfbfb;font-family:Arial,'Helvetica Neue',Helvetica,sans-serif;">
                    <span style="margin-right:8px;">{{ stars }}</span>
                    <span style="font-weight:bold;">{{ label }}</span>
                  </td>
                </tr>
